# Container image for Vercel, which builds this file on every deploy. It matches ./Dockerfile
# (keep the two in step) except for the last block: Vercel sends traffic to port 80, which
# only root can bind.
FROM python:3.12-slim

ENV PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

RUN useradd --create-home --uid 1000 user \
    && mkdir /home/user/app && chown user:user /home/user/app
USER user
ENV HOME=/home/user PATH=/home/user/.local/bin:$PATH
WORKDIR /home/user/app

COPY --chown=user requirements.txt .
RUN pip install --user -r requirements.txt

COPY --chown=user . .
# Train at build time (same recipe and random_state as the notebook) so the server starts fast.
RUN python train.py

USER root
ENV PORT=80
EXPOSE 80
CMD ["sh", "-c", "exec uvicorn app:app --host 0.0.0.0 --port ${PORT}"]
